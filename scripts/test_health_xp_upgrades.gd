extends SceneTree
func _initialize() -> void:
 call_deferred("run")
func run() -> void:
 var game: Node = load("res://main.tscn").instantiate()
 root.add_child(game)
 await process_frame
 game.set_process(false)
 game.start_run()
 game.update_stats_preview()
 assert(game.stat_names.speed.text == "Velocidade")
 game._apply_upgrade("speed")
 game.update_stats_preview()
 assert(game.stat_names.speed.text == "Velocidade (2)")
 assert(is_equal_approx(game.speed, 200.0))
 game._apply_upgrade("speed")
 game.update_stats_preview()
 assert(game.stat_names.speed.text == "Velocidade (3)")
 assert(is_equal_approx(game.speed, 220.0))
 var initial_damage: float = game.damage
 game._apply_upgrade("damage")
 assert(is_equal_approx(game.damage, initial_damage + 10.0))
 for rank in 9: game._apply_upgrade("damage")
 assert(is_equal_approx(game.damage, 110.0), "Ten damage upgrades add 100 damage")
 assert(is_equal_approx(1.0 / game.attack_delay, 1.0))
 for rank in 10:
  var expected_rate: float = 1.0 + 0.5 * (rank + 1)
  assert(is_equal_approx(game.projected_stats("rate").rate, expected_rate))
  game._apply_upgrade("rate")
  assert(is_equal_approx(1.0 / game.attack_delay, expected_rate))
 assert(is_equal_approx(1.0 / game.attack_delay, 6.0))
 game.health = 40
 game._apply_upgrade("max_health")
 assert(is_equal_approx(game.max_health, game.MAX_HEALTH * 1.20))
 assert(is_equal_approx(game.health, 40 + game.MAX_HEALTH * 0.20))
 for rank in 20: game._apply_upgrade("max_health")
 assert(is_equal_approx(game.max_health, game.MAX_HEALTH * (1.0 + 0.20 * 21)))
 game._apply_upgrade("xp_bonus")
 game.collect_xp(1)
 assert(is_equal_approx(game.current_xp(), 1.2))
 assert(game.format_xp(15.7) == "15,7")
 game.update_stats_preview()
 game._process(0)
 assert(game.xp_label.text.begins_with("1,2 /"))
 assert(not game.xp_label.text.contains("(lv"))
 assert(game.hud.text.contains("ELIMINAÇÕES 0"))
 for key in ["health", "level", "xp"]: assert(not game.stat_values.has(key))
 game.graphics_quality = 2
 game.add_xp_number(game.player, 1.2)
 assert(game.damage_numbers[-1].text == "+1 XP")
 game.add_xp_number(game.player, 1.9)
 assert(game.damage_numbers[-1].text == "+1 XP")
 game.add_xp_number(game.player, 2.0)
 assert(game.damage_numbers[-1].text == "+2 XP")
 for pickup in 9: game.collect_xp(1)
 assert(game.xp == 12 and game.xp_remainder == 0)
 for rank in 20: game._apply_upgrade("xp_bonus")
 assert(game.xp_bonus == 420)
 var before: int = game.xp
 assert(game.collect_xp(5) == 26 and game.xp == before + 26)
 game.speed = 1000.0
 game.show_upgrades()
 assert(game.choices.size() == 3)
 assert(not "magnet" in game.choices)
 game.update_stats_preview()
 assert(game.stat_values.max_health.text == game.format_integer(roundi(game.max_health)))
 assert(game.stat_values.xp_bonus.text == "+420%")
 game.resume()
 game.health = 10
 game.xp = game.xp_needed()
 game.spawn_timer = INF
 game.attack_timer = INF
 game.update_game(0)
 assert(game.health == game.max_health)
 game.start_run()
 assert(game.max_health == game.MAX_HEALTH and game.health == game.MAX_HEALTH and game.xp_bonus == 0 and game.xp_remainder == 0)
 assert(game.damage == 10.0 and game.projected_stats("damage").damage == 20.0)
 assert(game.attack_delay == 1.0)
 for sample in [["piranha", 10.0], ["pintado", 100.0], ["pacu", 40.0], ["dourado", 100.0], ["", 20000.0], ["pai_do_mato", 150000.0]]:
  game.spawn_enemy(sample[0] in ["", "pai_do_mato"], sample[0])
  assert(game.enemies.back().max_hp == sample[1])
 var forest_boss: Dictionary = game.enemies[-1]
 var worm: Dictionary = game.enemies[-2]
 game.elapsed = 1200.0
 game.update_game(0.0)
 assert(is_equal_approx(forest_boss.max_hp, worm.max_hp * 7.5))
 game.update_stats_preview()
 assert(game.stat_names.speed.text == "Velocidade")
 print("HEALTH/XP PASS: unlimited health, fractional rewards, unlimited XP bonus, labels, choices, full heal and reset")
 quit()
